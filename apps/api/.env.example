# Reference copy only. Copy the repository-root .env.example to <repository>/.env.
# apps/api/.env is intentionally not auto-loaded, so the result never depends on cwd.
# Local development only. Production must obtain Workspace identity from authentication.
ODYSSEY_ENVIRONMENT=development
ODYSSEY_DEVELOPMENT_WORKSPACE_ID=0195f076-b6e6-7ef0-98db-d721990f8001
ODYSSEY_DEVELOPMENT_WORKSPACE_NAME=Odyssey Development

ODYSSEY_DATABASE_URL=postgresql+asyncpg://odyssey:odyssey@localhost:5432/odyssey
# JSON array; never use "*".
ODYSSEY_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

ODYSSEY_S3_ENDPOINT_URL=http://localhost:9000
ODYSSEY_S3_ACCESS_KEY=odyssey
ODYSSEY_S3_SECRET_KEY=replace-me
ODYSSEY_S3_BUCKET=odyssey
